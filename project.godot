config_version=5

[application]

config/name="On the Rocks: The Last Shift"
config/description="Game Off 2026 — theme SHIFT. A murder mystery you solve twice: sober, and with The Voice."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Story="*res://scripts/Story.gd"

[display]

